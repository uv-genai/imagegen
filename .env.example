# Copy to .env and fill in. `docker compose` reads .env automatically for every
# command, so you do not have to prefix each one with the key.
#
# .env is gitignored; this example file is not, and must never contain a real key.

# Required. Generate one with: openssl rand -hex 24
IMAGEGEN_API_KEYS=

# cuda | vulkan
IMAGEGEN_BACKEND=cuda

# Host port published for the gateway.
IMAGEGEN_PORT=8080

# Optional: bind-mount weights from this host directory instead of using the
# named "imagegen-models" volume.
# IMAGEGEN_MODELS_DIR=/path/to/models
